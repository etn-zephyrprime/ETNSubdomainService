# Copy this file to .env (gitignored) and fill in the two secret values below.
# Image generation works fine without any of this — it only affects the R2 upload step,
# which is fire-and-forget (failures are logged, never block the response to the frontend).

# On-chain ownership check for POST /api/generate-nft — a caller must sign a message proving
# they own the node (verified via NameWrapper.ownerOf) before the backend will generate/persist
# an NFT image for it. Both default to the same mainnet values the frontend uses (see
# src/config.js's RPC_URL / NAME_WRAPPER_ADDRESS) — override if you're pointed at a different
# chain/deployment than the frontend (e.g. testnet).
#
# This is also the endpoint every backend cache/watcher gets via utils/rpcProvider.js's
# createRpcProvider() (see that file), used as the primary. The bare public URL below is fine for
# light/occasional use, but hourlyActivityCache.js and nftSalesCache.js can exhaust its anonymous
# rate limit on their own — get a free API-key URL from Ankr's dashboard and set it here (as a
# real environment variable, never committed to this file) once you're running those.
# (dailyBlockStatsCache.js — previously the heaviest RPC consumer here — no longer uses RPC_URL at
# all; see its own section below.) Confirmed live this backend can also lose an entire keyed
# endpoint outright (Ankr disabling a key: "API key disabled", -32051/403, not a rate limit,
# likely triggered by a genuine usage spike rather than anything malicious — confirmed live via
# Ankr's own per-project request-volume dashboard) — see RPC_URL_FALLBACK below for why every
# cache/watcher survives that now instead of all going down with it.
# RPC_URL=https://rpc.ankr.com/electroneum
# NAME_WRAPPER_ADDRESS=0xd8F4B1A91469B05d9E0b15Cac4917Ee47b2A6f64
#
# utils/rpcProvider.js — the secondary endpoint every cache/watcher's provider fails over to when
# RPC_URL errors (an actual failover — try the primary, use this one instead for
# RPC_PRIMARY_COOLDOWN_MS if it fails, not just another rate-limit-spreading split). Defaults to
# Electroneum's own public RPC. Note this one specifically needs requests sent via plain fetch(),
# not ethers' own Node HTTP client — confirmed live that client gets a 403 from this endpoint that
# neither curl nor fetch() does (almost certainly a TLS/HTTP client fingerprint check on their
# side); rpcProvider.js already does this correctly, only relevant if you ever touch that file.
# RPC_URL_FALLBACK=https://rpc.electroneum.com
#
# How long (ms) to skip RPC_URL entirely after it fails, before trying it again. Defaults to 60000
# (1 minute). Lower means recovering faster once RPC_URL is fixed; higher means fewer wasted
# requests to a primary you already know is down (a fully disabled key, this incident's actual
# cause, fails every single request until someone fixes it manually — with no cooldown at all,
# every RPC call across the whole backend would pay one guaranteed-failing request to it first,
# for as long as the outage lasts).
# RPC_PRIMARY_COOLDOWN_MS=60000

# scripts/backfillNftImages.js only — which contract/block range to scan for existing
# registrations. Same defaults as src/config.js's MARKETPLACE_ADDRESS/MARKETPLACE_DEPLOY_BLOCK;
# override if backfilling against a different deployment.
# MARKETPLACE_ADDRESS=0x392fd031910e5D58650160f41a501ccc29B1eD13
# MARKETPLACE_DEPLOY_BLOCK=15207471

# Pre-filled from your Cloudflare account (dash.cloudflare.com/c34c357361ccc93e89f36439889cc3c7/r2/...)
R2_ENDPOINT=https://c34c357361ccc93e89f36439889cc3c7.r2.cloudflarestorage.com
R2_BUCKET_NAME=electroneum-name-service

# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
# (Object Read & Write, scoped to the electroneum-name-service bucket is enough)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare dashboard -> R2 -> electroneum-name-service bucket -> Settings -> Public Access
# Enable the r2.dev subdomain (or use a custom domain you've connected) and paste it here,
# e.g. https://pub-xxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=

# Telegram notifications (utils/marketplaceWatcher.js) — posts to your chat whenever a domain is
# activated or a subname is registered through the marketplace. Optional: if either is unset, the
# watcher logs that it's disabled and the rest of the backend runs exactly as before.
#
# Every buyer/seller/payer address shown resolves to that wallet's primary .etn name (falling
# back to a shortened address if it hasn't set one) — see utils/primaryNameResolver.js. Same
# REVERSE_REGISTRAR_ADDRESS override below (shared with the Core Clash bots' NFT sale/mint/swap
# alerts, which resolve trader addresses the same way).
#
# TELEGRAM_BOT_TOKEN: message @BotFather on Telegram -> /mybots -> select your bot -> API Token.
# TELEGRAM_CHAT_ID: the target chat/group/channel id (supergroup ids are negative,
# e.g. -1002905908099). The bot must already be a member of that chat with permission to post,
# or sendMessage will fail with "chat not found"/"bot was kicked".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional — targets a specific topic in a forum-mode group instead of General. Open the topic
# in Telegram -> topic name -> Copy Link -> the trailing number in
# https://t.me/c/<chat>/<thread_id> is this value.
# TELEGRAM_MESSAGE_THREAD_ID=

# How often the watcher polls for new events, in ms. Was 60000 (1 minute); bumped to 300000 (5
# minutes) as part of cutting this backend's overall RPC volume (see rpcProvider.js's header
# comment) — this only posts a Telegram alert, sub-minute latency was never actually needed.
# WATCHER_POLL_INTERVAL_MS=300000

# Block explorer used for the "View Transaction" link in notifications. Same default as the
# frontend's EXPLORER_BASE_URL (src/config.js).
# EXPLORER_BASE_URL=https://blockexplorer.electroneum.com

# Subname domains cache (utils/subnameDomainsCache.js) — keeps a small public JSON file in R2
# (same bucket as above) listing every domain currently selling subnames, so the frontend's
# "Get a Subname" screen can fetch it in one request instead of scanning the marketplace's full
# on-chain history itself. Requires only the R2_* vars above; no separate config needed. If R2
# isn't configured, this is skipped entirely and the frontend falls back to scanning on-chain
# directly (slower, but still correct).
#
# How often it refreshes, in ms. Was 300000 (5 minutes), bumped to 900000 (15) as part of cutting
# this backend's overall RPC volume (see rpcProvider.js) — after the first run each tick only
# scans the handful of blocks since the last one, so this was cheap already, but every cache here
# got the same across-the-board bump for one consistent "data may lag up to 15 min" story.
# SUBNAME_DOMAINS_CACHE_INTERVAL_MS=900000

# Activated domains cache (utils/activatedDomainsCache.js) — same R2-publishing pattern as the
# subname domains cache above, for the homepage's "Activated Domains" table (every activated
# domain + its registered subnames, with current owner/primary-name/expiry). Requires only the
# R2_* vars above. No on-chain fallback in the frontend for this one — see
# src/hooks/useActivatedDomains.js for why; if R2 isn't configured, the table just shows an error
# state instead of scanning on-chain itself.
#
# Same REVERSE_REGISTRAR_ADDRESS default as src/config.js — override only if pointed at a
# different deployment than the frontend.
# REVERSE_REGISTRAR_ADDRESS=0xFBB14eDBD8D3f6E7BB240bFA388f6582df0d8E7A
#
# How often it refreshes, in ms. Was 300000 (5 minutes), bumped to 900000 (15) as part of cutting
# this backend's overall RPC volume (see rpcProvider.js) — every entry's owner/expiry gets
# re-verified on every cycle (not just newly-discovered ones — see the file's header comment for
# why), which made this one of the largest steady-state RPC consumers here even though its own
# event-scanning is cheap. The frontend's Activated Domains table
# (src/components/ActivatedDomainsTable.jsx) carries a note explaining the resulting lag.
# ACTIVATED_DOMAINS_CACHE_INTERVAL_MS=900000
#
# Caps how many blocks of event history one cycle scans — on a cold cache (fresh deploy, or R2
# wiped) that's the whole history back to MARKETPLACE_DEPLOY_BLOCK, which this cache is too heavy
# to safely do in one all-or-nothing pass (see the file's header comment — this is what "Couldn't
# load activated domains" on first deploy traces back to). A large backlog gets consumed
# gradually across several cycles instead, ACTIVATED_DOMAINS_MAX_BLOCKS_PER_CYCLE blocks at a
# time, checkpointing (and publishing whatever's been found so far) after every one. Doesn't
# affect steady-state behavior — only matters when there's more backlog than this to catch up on.
# ACTIVATED_DOMAINS_MAX_BLOCKS_PER_CYCLE=50000

# Marketplace sellers cache (utils/marketplaceSellersCache.js) — same R2-publishing pattern, for
# the "Names For Sale" marketplace screen's Seller field. Only resolves primary names for active
# listings' sellers — the listings themselves stay a live on-chain read (see the file's header
# comment for why: ManageSubdomain.jsx's live "List for Resale"/"Cancel Listing" gating needs that
# to reflect a just-submitted transaction immediately, which a cache can't). Requires only the
# R2_* vars above.
#
# How often it refreshes, in ms. Was 300000 (5 minutes), bumped to 900000 (15) as part of cutting
# this backend's overall RPC volume (see rpcProvider.js).
# MARKETPLACE_SELLERS_CACHE_INTERVAL_MS=900000

# Owned names cache (utils/ownedNamesCache.js) — every *wrapped* name (top-level domain or
# subname, activated or not), for "Manage & Resell" / "Register Subdomain" to list a connected
# wallet's own names instead of making them type one in. Same cold-start-safe design as
# activatedDomainsCache.js from the start (see that file's own history for why this matters).
# Does NOT include genuinely unwrapped ("retro") names — there's no event that carries their
# plaintext label; see the file's header comment. Requires only the R2_* vars above.
#
# How often it refreshes, in ms. Was 300000 (5 minutes), bumped to 900000 (15) as part of cutting
# this backend's overall RPC volume (see rpcProvider.js) — same "re-verifies every known name
# every cycle" cost driver as activatedDomainsCache.js above. "Your Names" in
# src/components/ManageSubdomain.jsx carries a note explaining the resulting lag.
# OWNED_NAMES_CACHE_INTERVAL_MS=900000
#
# Same backlog-per-cycle cap as ACTIVATED_DOMAINS_MAX_BLOCKS_PER_CYCLE, same reasoning.
# OWNED_NAMES_MAX_BLOCKS_PER_CYCLE=50000

# Name Service stats cache (utils/nameServiceStatsCache.js) — backs the dashboard's "Name
# Service" tab: a timestamped event history (domain registrations, activations, subname
# registrations, marketplace sales) for a trend chart, plus a live floor-price/active-listings
# snapshot. Independent scanner/cursor from ownedNamesCache.js above, same three of its four
# watched events plus ListingSold. Also scans BaseRegistrarImplementation directly (every .etn
# domain mints through this contract regardless of which app registered it — not just this app's
# own Marketplace activity) for a real "Total .etn Domains, all of Electroneum" stat. Requires
# only the R2_* vars above.
#
# Same defaults as src/config.js's BASE_REGISTRAR_ADDRESS; override only if pointed at a different
# deployment than the frontend. BASE_REGISTRAR_DEPLOY_BLOCK is this contract's own earliest
# transaction — deployed *before* the Marketplace contract, so this backfills further back than
# MARKETPLACE_DEPLOY_BLOCK alone would.
# BASE_REGISTRAR_ADDRESS=0x5207496C1248BbD2AeeDd57Bde44dd9d4E9F1b59
# BASE_REGISTRAR_DEPLOY_BLOCK=15031631
#
# How often it refreshes, in ms. Was 300000 (5 minutes), bumped to 900000 (15) as part of cutting
# this backend's overall RPC volume (see rpcProvider.js).
# NAME_SERVICE_STATS_CACHE_INTERVAL_MS=900000
#
# Same backlog-per-cycle cap as ACTIVATED_DOMAINS_MAX_BLOCKS_PER_CYCLE, same reasoning.
# NAME_SERVICE_STATS_MAX_BLOCKS_PER_CYCLE=50000

# Subdomain advert scheduler (utils/subdomainAdvertScheduler.js) — posts one of three rotating
# promo messages (activate a domain, get a subname, marketplace listings) to this repo's own bot
# via TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID/TELEGRAM_MESSAGE_THREAD_ID above, once a day at a
# randomized time. Requires only TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID (same as
# marketplaceWatcher.js) — no separate config. Two of the three adverts read live/cached data
# (current domains selling subnames, current marketplace listings) — nothing to configure for
# that either, but they'll post "no domains/listings yet" text if either is genuinely empty.
#
# Base URL every advert's links are built from — same default as marketplaceWatcher.js's SITE_URL.
# SITE_URL=https://nameservice.planetzephyros.xyz

# ETN price cache (utils/etnPriceCache.js) — publishes the live ETN/USD price to R2 so the
# frontend can show a "≈ $X.XX" estimate next to prices site-wide (UsdEstimate.jsx) without every
# visitor's browser hitting CoinGecko directly. Requires only the R2_* vars above.
#
# How often it refreshes, in ms. Defaults to 300000 (5 minutes).
# ETN_PRICE_CACHE_INTERVAL_MS=300000

# Personal Telegram alerts (utils/telegramLinkRouter.js) — lets a wallet opt in (from the site) to
# a personal DM whenever one of its names/subnames sells, on top of the public channel post
# marketplaceWatcher.js always makes. Requires TELEGRAM_BOT_TOKEN above plus:
#
# This service's own public URL — Telegram needs an HTTPS address to POST incoming messages
# (specifically "/start <code>" from the linking deep link) to. Without this, linking requests
# still work but never complete — the frontend shows "Waiting for confirmation..." forever, since
# there's nowhere for Telegram to tell this backend the user finished linking. Same public URL as
# the frontend's VITE_BACKEND_IMAGE_URL points at (see src/config.js's BACKEND_IMAGE_URL).
# BACKEND_PUBLIC_URL=https://electroneumnameservice.onrender.com
#
# Optional but recommended — verified against Telegram's X-Telegram-Bot-Api-Secret-Token header
# on every webhook call, so a POST to /api/telegram/webhook that didn't actually come from
# Telegram can't fabricate a "this address just linked" update. Any long random string; set the
# same value here and it's automatically passed to Telegram's setWebhook call at boot.
# TELEGRAM_WEBHOOK_SECRET=
#
# Optional — skips one getMe() API call at boot (and on the first link request after every
# restart) by not having to ask Telegram for its own bot username to build the t.me deep link.
# Purely a minor optimization; omit and it's fetched automatically.
# TELEGRAM_BOT_USERNAME=EnsSubdomainServiceETN_bot

# Expiry alerts (utils/expiryAlertScheduler.js) — DMs a wallet (via the personal-alerts link
# above) when one of its activated domains or subnames is coming up on expiry. Deliberately
# personal-only, never posted to the public channel — see the file's header comment for why.
# Requires the same config as personal Telegram alerts above (TELEGRAM_BOT_TOKEN,
# BACKEND_PUBLIC_URL) plus the R2_* vars — no separate setup.
#
# How often it checks, in ms. Defaults to 86400000 (once a day) — expiry dates don't move fast
# enough to need tighter polling.
# EXPIRY_ALERT_CHECK_INTERVAL_MS=86400000
#
# Comma-separated days-before-expiry to warn at (each name gets DMed once per tier it crosses, not
# once per check). Defaults to "30,7,1".
# EXPIRY_ALERT_TIER_DAYS=30,7,1

# Dashboard stats history (utils/dashboardStatsCache.js) — hourly snapshots of Electroneum
# network stats (total addresses, total blocks, avg block time, gas price, transactions-per-hour)
# published to R2, backing the dashboard's (dashboard.planetzephyros.xyz) Overview tab charts for
# those specific metrics. Blockscout itself has no historical endpoint for any of them (confirmed
# by probing — only /stats/charts/market and /stats/charts/transactions exist server-side), so
# this is the only way to chart them at all; it starts collecting the moment it first deploys and
# has no way to backfill data from before that. Requires only the R2_* vars above.
#
# How often it snapshots, in ms. Defaults to 3600000 (1 hour) — matches "Txs Today, by the hour"'s
# granularity; the other 4 metrics are charted at whatever this cadence is too.
# DASHBOARD_STATS_CACHE_INTERVAL_MS=3600000
#
# How many snapshots to keep (oldest dropped once exceeded). Defaults to 720 (30 days at the
# default hourly cadence) — bounds the published file's size regardless of uptime.
# DASHBOARD_STATS_MAX_SNAPSHOTS=720

# Daily block stats cache (utils/dailyBlockStatsCache.js) — real per-UTC-day tx counts +
# validator breakdowns for the Overview tab's 90-day "Total Transactions" chart and "Total
# Blocks" heatmap. Requires only the R2_* vars above.
#
# Was originally a raw-RPC scan (~1.5M `eth_getBlockByNumber` calls to backfill 90 days) — that
# backfill, on its own, was most of this backend's RPC volume and the likeliest actual cause of an
# Ankr key getting disabled outright for excess usage (confirmed live via Ankr's own per-project
# request-volume dashboard). Rewritten to scan Blockscout's own `/api/v2/blocks` list instead —
# same migration, same reasoning, and the same tuning knobs as validatorRewardsCache.js below:
# zero RPC calls now, ~31,000 page requests (50 blocks/page) for a full 90-day backfill against
# Blockscout instead. Sequential by design (no concurrency knob) with a small delay between
# requests.
#
# How often it refreshes, in ms. Defaults to 300000 (5 minutes).
# DAILY_BLOCK_STATS_CACHE_INTERVAL_MS=300000
#
# Caps pages scanned per cycle (50 blocks/page) — conservative by default since Blockscout's rate
# limits for this volume aren't documented; raise once you've confirmed sustained operation
# doesn't trip anything.
# DAILY_BLOCK_STATS_MAX_PAGES_PER_CYCLE=200
#
# Delay between sequential page requests, in ms.
# DAILY_BLOCK_STATS_PAGE_DELAY_MS=150

# Hourly activity cache (utils/hourlyActivityCache.js) — real per-UTC-hour tx counts + ETN volume
# for the Overview tab's "Txs (Last 7 Days)" heatmap. Requires only the R2_* vars above.
#
# Rolling 8-day window (~138K blocks), lighter than dailyBlockStatsCache.js above but fetches
# *full* transaction objects (needed for tx.value), not just headers — meaningfully heavier per
# call. Same RPC_URL requirement and same tuning knobs as dailyBlockStatsCache.js above.
# HOURLY_ACTIVITY_CACHE_INTERVAL_MS=300000
# HOURLY_ACTIVITY_MAX_BLOCKS_PER_CYCLE=4000
# HOURLY_ACTIVITY_CONCURRENCY=3

# Validator rewards cache (utils/validatorRewardsCache.js) — real per-UTC-day, per-validator
# block counts and ETN rewards earned for the last 90 days, for the Overview tab's "Validators"
# tile + per-validator line chart. Requires only the R2_* vars above.
#
# Does NOT use RPC_URL at all — this chain's RPC has no `eth_getBlockReceipts`, so computing
# reward data via RPC would mean one call per *transaction*, not per block. Instead scans
# Blockscout's own `/api/v2/blocks` list (EXPLORER_BASE_URL above), which already computes each
# block's reward server-side and returns 50 blocks/page — ~31,000 page requests for a full 90-day
# backfill instead of ~1.5M RPC calls, against a completely separate budget from every other cache
# here. Sequential by design (no concurrency knob) with a small delay between requests.
#
# How often it refreshes, in ms. Defaults to 300000 (5 minutes).
# VALIDATOR_REWARDS_CACHE_INTERVAL_MS=300000
#
# Caps pages scanned per cycle (50 blocks/page) — conservative by default since Blockscout's rate
# limits for this volume aren't documented; raise once you've confirmed sustained operation
# doesn't trip anything.
# VALIDATOR_REWARDS_MAX_PAGES_PER_CYCLE=200
#
# Delay between sequential page requests, in ms.
# VALIDATOR_REWARDS_PAGE_DELAY_MS=150

# ==================== Core Clash Telegram bots ====================
# Ported from etn-zephyrprime/CoreClashGame (burn/swap/NFT-mint/NFT-sale alerts, the advert
# rotation, and the CORE drip bot) — see backend/utils/coreClashConfig.js for why. All prefixed
# COREBOT_ to avoid colliding with this repo's own TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above,
# since these are two different bots posting into the same chat. State (last-scanned block per
# watcher, the advert queue) reuses the R2_* config above under separate keys — no extra R2 setup
# needed. Every watcher below independently no-ops if its required vars aren't set.

# The "Zephyros" bot — burn/swap/NFT mint/NFT sale/drip alerts.
COREBOT_ZEPHYROS_BOT_TOKEN=
# The "Core Clash" bot — advert rotation only.
COREBOT_TELEGRAM_BOT_TOKEN=
# Same chat both bots post into (must be a member with post permission in both cases).
COREBOT_TELEGRAM_CHAT_ID=
# Optional — topic thread for swap/drip alerts. Omit to post to General.
# COREBOT_ZEPHYROS_GENERAL_THREAD_ID=
# Optional — topic thread for NFT mint/sale alerts. Defaults to 782 (CoreClashGame's existing
# thread in this chat) if unset.
# COREBOT_ZEPHYROS_NFT_THREAD_ID=782

# CORE token contract — required for the burn and swap watchers.
CORE_TOKEN_ADDRESS=

# Core Clash treasury/admin wallet — required only for the drip bot, which signs and sends a real
# on-chain transaction (contractWithSigner.drip()) when the drip contract's timer is due. A
# *different* wallet from this repo's own BACKEND_PRIVATE_KEY (if you have one set for something
# else), hence the distinct name — do not reuse that value here. Treat this the same as you would
# in CoreClashGame's own .env: never commit it, rotate if ever exposed.
# CORE_CLASH_BACKEND_PRIVATE_KEY=

# All of the below have working defaults (same contracts/addresses CoreClashGame itself uses) —
# only set these if you're pointed at a different deployment.
# VKIN_CONTRACT_ADDRESS=0x3fc7665B1F6033FF901405CdDF31C2E04B8A2AB4
# VQLE_CONTRACT_ADDRESS=0x8cFBB04c54d35e2e8471Ad9040D40D73C08136f0
# SCIONS_CONTRACT_ADDRESS=0xAc620b1A3dE23F4EB0A69663613baBf73F6C535D
# EVG_CONTRACT_ADDRESS=0x5C81a5609EaeEF7962F1D089D6343F9790387901
# CORE_WETN_POOL_ADDRESS=0xc3FE6f98765493aB62AD87C9B5022Ff2FAA2e98D
# SEAPORT_ADDRESS=0x678748317e7fD5B7699D07e666087608B401cbFd
# ELECTROSWAP_BASE_URL=https://app.electroswap.io

# How often each of the 4 alert-posting Core Clash watchers polls, in ms. Was 60000 (1 minute),
# bumped to 300000 (5) as part of cutting this backend's overall RPC volume (see
# rpcProvider.js) — these only post Telegram alerts, sub-minute latency was never actually needed,
# and shared across 4 watchers made this a real chunk of total volume.
# COREBOT_POLL_INTERVAL_MS=300000

# How often the drip bot checks the drip contract's timer, in ms. Was hardcoded to 300000 (5
# minutes); now overridable, defaulting to 900000 (15). Kept less aggressive a bump than the
# alert-only watchers above since this one actually signs and sends a transaction when due — worst
# case this delays firing an overdue drip by up to 15 minutes, not meaningful against a
# multi-hour drip schedule.
# COREBOT_DRIP_CHECK_INTERVAL_MS=900000

# How far back to scan when a watcher has no saved cursor (first run, or R2 unreachable) —
# same reasoning as WATCHER_LOOKBACK_BLOCKS above. Defaults to 50000 blocks (~3 days).
# COREBOT_LOOKBACK_BLOCKS=50000

# ============================================================
# Premium Feature #1 — Per-Wallet PnL Statements
# ============================================================
# See backend/services/pnlStatementGenerator.js and the PremiumSubscription contract in the
# PlanetZephyros repo (contracts/premium/PremiumSubscription.sol). Every piece below no-ops
# cleanly if unset, same as this backend's other optional features.

# Supabase's pooled (pgbouncer, port 6543) connection string — NOT the direct 5432 one. This is
# the first relational database this backend has ever used; everything else is R2 JSON blobs. Run
# `npm run migrate` (backend/scripts/runMigrations.js) against this before anything else works.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Set to "false" only for a local/non-Supabase Postgres in dev that has no TLS at all — Supabase
# itself requires SSL (see backend/db/pool.js's own comment on why rejectUnauthorized:false is
# Supabase's own documented setting here, not a general "skip verification" shortcut).
# DATABASE_SSL=false

# Deployed address of PremiumSubscription (PlanetZephyros repo). Deployed to MAINNET 2026-08-31 —
# owner/coreToken/swapRouter confirmed correct on-chain; a full dry run (purchase -> split -> real
# ETN->CORE swap -> burn) verified working end-to-end before pnlPricePerPeriod was reset from its
# test value to its real price (see src/config.js in this repo for the full deploy history note).
# Required for the event watcher, both PnL cron schedulers, and the refund endpoint. Still commented
# out here on purpose, same as MARKETPLACE_ADDRESS's own example line above — the real value must
# be set directly in Render's Environment tab, never committed.
# PREMIUM_SUBSCRIPTION_ADDRESS=0x05Cc5a4Cbf18113f7e9c1675a0Ffc702BA7876E1

# Block PremiumSubscription was deployed at — bounds the watcher's cold-start backfill the same
# way MARKETPLACE_DEPLOY_BLOCK does for the marketplace watcher.
# PREMIUM_SUBSCRIPTION_DEPLOY_BLOCK=15621940

# How often the event watcher polls for MembershipPurchased/PnlPeriodsPurchased, in ms. Real
# payments land here, unlike the 5-minute-is-fine Telegram notification watchers — defaults to
# 60000 (1 minute), not 300000.
# PREMIUM_SUBSCRIPTION_POLL_INTERVAL_MS=60000
# PREMIUM_SUBSCRIPTION_LOOKBACK_BLOCKS=50000

# The 14-day auto-finalize threshold (see PremiumSubscription.sol's header comment on the two
# finalize triggers), in ms. Defaults to the real 14 days (1209600000ms). Override with a small
# value ONLY for the accelerated-clock testnet lifecycle test described in the build plan — never
# in production.
# PNL_AUTO_FINALIZE_MS=1209600000
# PNL_AUTO_FINALIZE_CHECK_INTERVAL_MS=3600000

# Buy-and-burn split execution — reuses CORE_CLASH_BACKEND_PRIVATE_KEY above as the
# PremiumSubscription contract's `operator` wallet (confirmed design: same wallet spans both
# product lines). Slippage tolerance matches PlanetZephyros's own scripts/autoBuyBackAndBurn.js
# default (500 bps / 5%, covering CORE's own fee-on-transfer tax plus ordinary price movement).
# PNL_SPLIT_EXECUTION_CHECK_INTERVAL_MS=300000
# PNL_SPLIT_SLIPPAGE_BPS=500
# PNL_SPLIT_GAS_LIMIT=500000
# PNL_REFUND_GAS_LIMIT=150000

# Historical price lookups (backend/services/pnlPricing.js) reuse tokenChartRouter.js's shared
# GeckoTerminal queue, no separate config needed. Set this ONLY for testnet lifecycle testing —
# GeckoTerminal will never index the testnet MockRouter/MockCoreToken pair, so this short-circuits
# every price lookup to a fixed value instead of failing. Never set in production.
# PNL_PRICING_TESTNET_STUB_USD=

# How long to wait between paginated Blockscout requests during per-wallet history ingestion
# (backend/services/pnlIngestion.js) — same politeness-delay reasoning as
# DAILY_BLOCK_STATS_PAGE_DELAY_MS.
# PNL_INGESTION_PAGE_DELAY_MS=150
